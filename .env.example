# Required: your Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: model selection (defaults shown)
MODEL_PRIMARY=claude-sonnet-4-20250514
MODEL_VALIDATION=claude-haiku-4-5-20251001

# Optional: token budgets
MAX_TOKENS_SPECIALIST=4096
MAX_TOKENS_VALIDATION=1024

# Optional: CORS allowed origins (comma-separated). Use "*" for development.
ALLOWED_ORIGINS=*

# Optional: port for local dev (Railway sets PORT automatically)
PORT=8000
